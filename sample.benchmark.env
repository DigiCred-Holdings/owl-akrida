# Local ACA-Py basic-message benchmark defaults.
# Mediation invitation is filled after the mediator starts.

# Leave empty / unset for direct holder delivery (bool("False") is True on clean main).
WITH_MEDIATION=
MEDIATION_URL=
MEDIATOR_DNS=mediator
PICKUP_STRATEGY=implicit

AGENT_IP=load-agent
LOCUST_FILES=locustBasicMsgBenchmark.py
LOCUST_USERS=1
LOCUST_SPAWN_RATE=1
LOCUST_MIN_WAIT=0
LOCUST_MAX_WAIT=0

CONNECTIONS_PER_AGENT=20
TARGET_MESSAGE_COUNT=10000
MESSAGE_TO_SEND=ping
VERIFIED_TIMEOUT_SECONDS=60

START_PORT=10000
END_PORT=10100

ISSUER_TYPE=acapy
ISSUER_URL=http://issuer:8150
ISSUER_HEADERS={}
VERIFIER_TYPE=acapy
VERIFIER_URL=http://issuer:8150
VERIFIER_HEADERS={}

# Dummy values required by settings.py even for basic-message tests
CRED_DEF=unused
SCHEMA=unused
CRED_ATTR=[{"mime-type": "text/plain","name": "score","value": "test"}]
LEDGER=none

# ACA-Py tuning knobs exercised by the benchmark scripts
ACAPY_LOG_LEVEL=info
ACAPY_WALLET_STORAGE_CONFIG={"url":"issuer-db:5432","max_connections":5}
ACAPY_WALLET_STORAGE_CREDS={"account":"test","password":"test","admin_account":"test","admin_password":"test"}
# NOTE: do not wrap JSON in bash ${var:-{...}} defaults; nested braces break parsing.
ACAPY_GENESIS_URL=

# Fast-path / mock-sink (set by run profiles; override here only if needed)
# FASTPATH_DELIVER_OVERRIDE=http://mock-holder:8090/
# FASTPATH_PACK_WORKERS=32
# MEASURE_MODE=e2e   # e2e | admin_only | fastpath | fastpath_admin

# Database sample env also used by issuer-db / redis-host
ACCOUNT=test
PASSWORD=test
ADMIN_ACCOUNT=test
ADMIN_PASSWORD=test
